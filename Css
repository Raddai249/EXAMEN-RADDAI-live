/* Sans-serif font for whole page */
body {
    font-family: Arial, Helvetica, sans-serif;
    margin: 0;
    padding: 0;
}

/* Header with background color */
header {
    background-color: #7b1fa2;
    color: white;
    text-align: center;
    padding: 30px;
}

/* Section spacing */
section {
    padding: 20px;
}

/* Table styling */
table {
    width: 100%;
    border-collapse: collapse;
}

th, td {
    border: 1px solid #333;
    padding: 12px;
}

th {
    background-color: #f3e5f5;
}

/* Button-style ticket link */
.btn {
    display: inline-block;
    background-color: #ff9800;
    color: white;
    padding: 12px 22px;
    text-decoration: none;
    border-radius: 6px;
    font-weight: bold;
}

.btn:hover {
    background-color: #e68900;
}
